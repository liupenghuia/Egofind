NODE_ENV=development
PORT=3000

# MySQL (matches root docker-compose.yml)
DATABASE_URL=mysql://egofind:egofind@localhost:3306/egofind

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

# WeChat mini-program (replace placeholders in production)
WECHAT_APPID=your-wechat-appid
WECHAT_SECRET=your-wechat-secret
# Set to 1 for local dev without real WeChat credentials
WECHAT_MOCK=1

# Phone encryption (AES-256-GCM key material)
PHONE_ENCRYPTION_KEY=dev-only-phone-key-change-me

# Matching
MATCH_SCOPE=county
MATCH_DMAX_KM=15

# Tencent Map WebService（逆地理 / 地址解析）
# 申请：https://lbs.qq.com/ → WebServiceAPI Key
TENCENT_MAP_KEY=your-tencent-map-key
# 无 Key 或逆地理失败时的默认区县 adcode
DEFAULT_ADCODE=130128

# 乘客「司机原因」反馈：每月达到该次数后禁止发车与查找乘客
DRIVER_REASON_MONTHLY_LIMIT=10
